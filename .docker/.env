# Project settings
PROJECT_TITLE="TYPO3 Ext. HHDev-LoremIpsum"
PROJECT_NAME="heikohardt-t3ext-hhdev-loremipsum"

# Compose settings
COMPOSE_PROJECT_NAME="${PROJECT_NAME}"

# Database settings
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="application"
DB_USER="developer"
DB_PASSWORD="P@ssw0rd"

# Proxy settings
TRAEFIK_DOMAIN=".hardt.dev"
TRAEFIK_IP="172.28.5.4"

# Network settings
DOCKER_NETWORK="HHDev_Network"
DOCKER_VOLUME="HHDev_Volume"

# Apache settings
APACHE_PORT="8080"
APACHE_PORT_SSL="8443"
APACHE_DOCUMENT_ROOT="/var/www/html/.public"
APACHE_SERVER_NAME="www-${PROJECT_NAME}${TRAEFIK_DOMAIN}"
APACHE_SERVER_ALIAS="localhost"

# PHP settings
XDEBUG_MODE="debug,develop"

# TYPO3 environment settings
TYPO3_CONTEXT="Development/Docker"
TYPO3_CLI=".bin/typo3"
TYPO3_VENDOR=".vendor"
## Reverse proxy settings – active by default, comment out for local testing
TYPO3__SYS__reverseProxyIP="*"
TYPO3__SYS__reverseProxyHeaderMultiValue="first"
TYPO3__SYS__reverseProxySSL="*"
## Site settings
TYPO3__SYS__sitename="${PROJECT_TITLE}"
TYPO3__SYS__systemLocale="de_DE.UTF-8"
TYPO3__SYS__encryptionKey="${SECRET_ENCRYPTIION_KEY}"
TYPO3__BE__installToolPassword="${SECRET_INSTALL_TOOL}"
TYPO3__BE__lockSSL="BOOL:true"
## DB connection
TYPO3__DB__Connections__Default__dbname="${DB_DATABASE}"
TYPO3__DB__Connections__Default__host="${DB_HOST}"
TYPO3__DB__Connections__Default__password="${DB_PASSWORD}"
TYPO3__DB__Connections__Default__user="${DB_USER}"
## Mail settings
TYPO3__MAIL__transport="smtp"
TYPO3__MAIL__transport_smtp_server="mailpit:1025"
TYPO3__MAIL__transport_transport_sendmail_command=""
TYPO3__MAIL__defaultMailFromAddress="developer@${APACHE_SERVER_NAME}"
## Debug settings
TYPO3__BE__debug="BOOL:true"
TYPO3__FE__debug="BOOL:true"
TYPO3__SYS__displayErrors="INT:1"
TYPO3__SYS__exceptionalErrors="INT:12290"
## Dev only – never enable in production
TYPO3__SYS__devIPmask="*."
TYPO3__SYS__trustedHostsPattern="${APACHE_SERVER_NAME}|localhost"
